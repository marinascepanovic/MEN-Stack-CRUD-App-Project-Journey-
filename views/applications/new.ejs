<!-- views/applications/new.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css">
  <title>Add a New Artist</title>
    <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  </style>
</head>

<body style="background-image: url('https://images.unsplash.com/photo-1607457561901-e6ec3a6d16cf?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8cGluayUyMGJhY2tncm91bmR8ZW58MHx8MHx8fDA%3D&fm=jpg&q=60&w=3000');">

  <%- include('../partials/_navbar.ejs') %>
    <h1 style="color:purple">Add a New Artist</h1>
    <form action="/users/<%=user._id%>/music" method="POST">
        <label style="color:purple" for="title"> Song Title:</label>
        <input id="title" name="title" type="text" required />

        <label style="color:purple" for="artist"> Artist Name:</label>
        <input type="text" name="artist" id="artist" />

          <label style="color:purple" for="previewURL"> Artist Image: </label>
        <input id="previewURL" name="previewURL" type="text" required  />

        <label style="color:purple" >Lyrics:</label>
        <textarea name="lyrics" name="lyrics" id="lyrics"></textarea>


        <div>
        
        <button type="submit"> Add </button>
        </div>
      </form>
      
</body>

</html>