<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Music Artists</title>
      <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  </style>
    <link rel="stylesheet" href="/style.css">  
</head>
   
<body style="background-image: url('https://images.unsplash.com/photo-1607457561901-e6ec3a6d16cf?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8cGluayUyMGJhY2tncm91bmR8ZW58MHx8MHx8fDA%3D&fm=jpg&q=60&w=3000');">
    <%- include('../partials/_navbar.ejs') %>
    <h1 style="text-align: center; color: purple">Artists</h1>
    <a href="/users/<%=user._id%>/music/new" class="btn-add">Add an Artist</a>

<ul>
    <% music.forEach((music)=> { %>
      

<ul class="artist-grid">

    <% }) %>
    <% music.forEach((music)=> { %>
        <li class="artist-card"> 
            <a href="/users/<%= user._id %>/music/<%= music._id %>"> 
                <h3 style="color:purple"><%= music.artist %> </h3>
                <img src="<%= music.previewURL %>" alt="<%= music.artist %>">
                <h4 style="color:purple"><%= music.title %></h4>
                
                <pre style="color:purple"><%= music.createdAt.toDateString() %></pre>

            </a>
        </li>
        
   <% }) %>
</ul>


</body>
</html>