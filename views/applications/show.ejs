<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css">
    <title>
        <%= music.title %>
    </title>
      <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  </style>
</head>

<body style="background-image: url('https://images.unsplash.com/photo-1607457561901-e6ec3a6d16cf?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8cGluayUyMGJhY2tncm91bmR8ZW58MHx8MHx8fDA%3D&fm=jpg&q=60&w=3000');">
    <%- include('../partials/_navbar.ejs') %>
    <h1 style="color:purple"<%= music.title %> by <%= music.artist %></h1>
    <img src="<%= music.previewURL %>" alt="<%= music.artist %>">
    <h3>Lyrics:</h3>
    <p><pre><%= music.lyrics %></pre></p>   

    <a href="/users/<%= user._id %>/music/<%= music._id %>/edit" class="btn-edit">EDIT</a>

<a href="/users/<%= user._id %>/music/<%= music._id %>/delete" class="btn-edit">DELETE</a>
</body>

</html>