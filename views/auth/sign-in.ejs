<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>Sign In</title>
    <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  </style>
</head>
<body style="background-image: url('https://images.unsplash.com/photo-1607457561901-e6ec3a6d16cf?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8cGluayUyMGJhY2tncm91bmR8ZW58MHx8MHx8fDA%3D&fm=jpg&q=60&w=3000');">
  <%- include('../partials/_navbar.ejs') %>
  <h1 style="color:purple">Sign in</h1>

  <form action="/auth/sign-in" method="POST">
    <label style="color:purple" for="username">Username:</label>
    <input type="text" name="username" id="username" required />
    <label style="color:purple" for="password">Password:</label>
    <input type="password" name="password" id="password" required />
    <button class="btn-edit" type="submit">Sign in</button>
  </form>
  
</body>
</html>